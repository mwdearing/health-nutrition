{
  "version": 1,
  "description": "Exact reference vectors for the nutrient semantics of catalog contract v1. Every quantity is a decimal string; no JSON number appears anywhere, and outside the reject cases every unit symbol is one the iOS UnitRegistry knows. Ops: convert (one unit conversion), scale (a label value scaled from its basis to a consumed amount: value times consumed, divided by the basis), sum (a total with its coverage), reject (the operation must fail with the named error). A result is exact unless a division does not terminate, in which case it is rounded to 10 fraction digits, halves away from zero, as contracts/nutrients/decimal-rules.md states. No input, product, sum or result may need more than 38 significant digits; one that would is refused as amount_out_of_range. The vectors follow the model of ios/NutritionCore/Sources/NutritionDomain; running them against the Swift code is the job of the Swift/Python golden verification that follows this contract. The optional `nutrient` field names the registry nutrient each case is about.",
  "error_names": [
    "unknown_symbol",
    "dimension_mismatch",
    "missing_density",
    "invalid_density",
    "missing_portion_definition",
    "invalid_portion_definition",
    "incompatible_count_units",
    "international_unit_not_convertible",
    "non_positive_amount",
    "negative_amount",
    "amount_out_of_range"
  ],
  "cases": [
    {
      "id": "convert_grams_to_milligrams",
      "op": "convert",
      "nutrient": "protein",
      "note": "Exact power of ten, never a division.",
      "input": {
        "amount": "1.5",
        "unit": "g",
        "to": "mg"
      },
      "expect": {
        "amount": "1500",
        "unit": "mg"
      }
    },
    {
      "id": "convert_kilograms_to_grams",
      "op": "convert",
