{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:healthrelay:schema:catalog-product-version:v1",
  "title": "healthrelay.catalog-product-version v1",
  "description": "One published version of one catalog product, as the public catalog serves it. Deny by default: every object level is closed, so any field that is not listed here - and nothing that identifies a person, a device or an intake - is refused. The nutrients object accepts only the nutrient ids of contracts/nutrients/registry.v1.json, each with the units the registry lists for it. Amounts are exact decimal strings, never JSON numbers, and never negative. Value states mirror the iOS NutrientValue cases.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product_id",
    "version",
    "name",
    "serving",
    "nutrients",
    "source",
    "status"
  ],
  "properties": {
    "product_id": {
      "$ref": "#/$defs/productId"
    },
    "version": {
      "description": "Monotonic version of this product record, starting at 1.",
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "$ref": "#/$defs/shortText"
    },
    "brand": {
      "$ref": "#/$defs/shortText"
    },
    "barcodes": {
      "description": "Barcodes this product is known by. Digits only, no check-digit interpretation.",
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/barcode"
      }
    },
    "serving": {
      "$ref": "#/$defs/serving"
    },
    "nutrients": {
      "$ref": "#/$defs/nutrientMap"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "status": {
      "description": "Only published records are part of v1. Draft, pending and withdrawn records are never served.",
      "const": "published"
    }
  },
  "$defs": {
    "productId": {
      "description": "Catalog-internal product identifier, opaque to clients.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^prod_[a-z0-9][a-z0-9._-]{0,55}(?!\\n)$"
    },
    "shortText": {
      "description": "Display text in any script, deny-listed for characters that hide or reorder what a person sees: no control characters, no line or paragraph separators, no bidirectional marks, overrides or isolates, no zero-width or other invisible format characters (soft hyphen, joiners, word joiner, byte order mark, interlinear annotation, tag characters), no unpaired surrogates or noncharacters, and no space of any kind at the start or the end.",
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u061c\\u180e\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u206f\\ud800-\\udfff\\ufeff\\ufff9-\\ufffb\\ufffe\\uffff\udb40\udc00-\udb40\udc7f\\u0020\\u00a0\\u1680\\u2000-\\u200a\\u202f\\u205f\\u3000](?:[^\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u061c\\u180e\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u206f\\ud800-\\udfff\\ufeff\\ufff9-\\ufffb\\ufffe\\uffff\udb40\udc00-\udb40\udc7f]*[^\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u061c\\u180e\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u206f\\ud800-\\udfff\\ufeff\\ufff9-\\ufffb\\ufffe\\uffff\udb40\udc00-\udb40\udc7f\\u0020\\u00a0\\u1680\\u2000-\\u200a\\u202f\\u205f\\u3000])?(?!\\n)$"
    },
    "barcode": {
      "description": "Digits only, 8 to 14 of them.",
      "type": "string",
      "pattern": "^[0-9]{8,14}(?!\\n)$"
    },
    "nonNegativeDecimal": {
      "description": "An exact decimal that is zero or more: digits, optional fractional digits. No sign, no exponent, no thousands comma, no NaN, no infinity, no empty string, and never a JSON number.",
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?(?!\\n)$"
    },
    "positiveDecimal": {
      "description": "A nonNegativeDecimal that is greater than zero.",
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^(?!0+(\\.0+)?(?!\\n)$)(0|[1-9][0-9]*)(\\.[0-9]+)?(?!\\n)$"
    },
    "servingUnit": {
      "description": "A mass, volume or count unit symbol from contracts/nutrients/registry.v1.json. A serving is never stated in kcal or IU.",
      "type": "string",
      "enum": [
        "g",
        "mg",
        "mcg",
        "kg",
        "mL",
        "L",
        "serving",
        "scoop",
        "tablet",
        "capsule",
        "piece",
        "gummy"
      ]
    },
    "energyUnit": {
      "description": "The energy unit symbol of the registry.",
      "type": "string",
      "enum": [
        "kcal"
      ]
    },
    "massUnit": {
      "description": "The mass unit symbols of the registry.",
      "type": "string",
      "enum": [
        "g",
        "mg",
        "mcg",
        "kg"
      ]
    },
    "massOrInternationalUnit": {
      "description": "The mass unit symbols of the registry, or IU for the nutrients labels state that way.",
      "type": "string",
      "enum": [
        "g",
        "mg",
        "mcg",
        "kg",
        "IU"
      ]
    },
    "serving": {
      "description": "The serving the nutrient values below are stated for: a positive amount in a mass, volume or count unit.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "unit"
      ],
      "properties": {
        "amount": {
          "$ref": "#/$defs/positiveDecimal"
        },
        "unit": {
          "$ref": "#/$defs/servingUnit"
        }
      }
    },
    "nutrientMap": {
      "description": "Nutrient values keyed by registry nutrient id. Only the ids of contracts/nutrients/registry.v1.json are accepted, each with the units the registry lists for it. Only known, unknown, not_applicable and below_reporting_threshold values may appear.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "energy": {
          "$ref": "#/$defs/energyNutrientValue"
        },
        "protein": {
          "$ref": "#/$defs/massNutrientValue"
        },
        "total_fat": {
          "$ref": "#/$defs/massNutrientValue"
        },
        "saturated_fat": {
          "$ref": "#/$defs/massNutrientValue"
        },
        "carbohydrate": {
          "$ref": "#/$defs/massNutrientValue"
        },
        "fiber": {
          "$ref": "#/$defs/massNutrientValue"
        },
        "sugars": {
          "$ref": "#/$defs/massNutrientValue"
        },
        "sodium": {
          "$ref": "#/$defs/massNutrientValue"
        },
        "potassium": {
          "$ref": "#/$defs/massNutrientValue"
        },
        "calcium": {
          "$ref": "#/$defs/massNutrientValue"
        },
        "iron": {
          "$ref": "#/$defs/massNutrientValue"
        },
        "vitamin_a": {
          "$ref": "#/$defs/massOrIUNutrientValue"
        },
        "vitamin_c": {
          "$ref": "#/$defs/massNutrientValue"
        },
        "vitamin_d": {
          "$ref": "#/$defs/massOrIUNutrientValue"
        },
        "caffeine": {
          "$ref": "#/$defs/massNutrientValue"
        },
        "water": {
          "$ref": "#/$defs/massNutrientValue"
        }
      }
    },
    "energyNutrientValue": {
      "description": "The value of an energy nutrient and its state. Only the known state carries an amount; the other three never do.",
      "type": "object",
      "required": [
        "state"
      ],
      "oneOf": [
        {
          "$ref": "#/$defs/energyNutrientKnown"
        },
        {
          "$ref": "#/$defs/nutrientUnknown"
        },
        {
          "$ref": "#/$defs/nutrientNotApplicable"
        },
        {
          "$ref": "#/$defs/energyNutrientBelowReportingThreshold"
        }
      ]
    },
    "energyNutrientKnown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "amount",
        "unit"
      ],
      "properties": {
        "state": {
          "const": "known"
        },
        "amount": {
          "$ref": "#/$defs/nonNegativeDecimal"
        },
        "unit": {
          "$ref": "#/$defs/energyUnit"
        }
      }
    },
    "energyNutrientBelowReportingThreshold": {
      "description": "Present but under the provider's reporting threshold. The unit is optional, because a provider may report the state without one.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "const": "below_reporting_threshold"
        },
        "unit": {
          "$ref": "#/$defs/energyUnit"
        }
      }
    },
    "massNutrientValue": {
      "description": "The value of a nutrient stated as a mass and its state. Only the known state carries an amount; the other three never do.",
      "type": "object",
      "required": [
        "state"
      ],
      "oneOf": [
        {
          "$ref": "#/$defs/massNutrientKnown"
        },
        {
          "$ref": "#/$defs/nutrientUnknown"
        },
        {
          "$ref": "#/$defs/nutrientNotApplicable"
        },
        {
          "$ref": "#/$defs/massNutrientBelowReportingThreshold"
        }
      ]
    },
    "massNutrientKnown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "amount",
        "unit"
      ],
      "properties": {
        "state": {
          "const": "known"
        },
        "amount": {
          "$ref": "#/$defs/nonNegativeDecimal"
        },
        "unit": {
          "$ref": "#/$defs/massUnit"
        }
      }
    },
    "massNutrientBelowReportingThreshold": {
      "description": "Present but under the provider's reporting threshold. The unit is optional, because a provider may report the state without one.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "const": "below_reporting_threshold"
        },
        "unit": {
          "$ref": "#/$defs/massUnit"
        }
      }
    },
    "massOrIUNutrientValue": {
      "description": "The value of a nutrient stated as a mass or in IU and its state. Only the known state carries an amount; the other three never do.",
      "type": "object",
      "required": [
        "state"
      ],
      "oneOf": [
        {
          "$ref": "#/$defs/massOrIUNutrientKnown"
        },
        {
          "$ref": "#/$defs/nutrientUnknown"
        },
        {
          "$ref": "#/$defs/nutrientNotApplicable"
        },
        {
          "$ref": "#/$defs/massOrIUNutrientBelowReportingThreshold"
        }
      ]
    },
    "massOrIUNutrientKnown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "amount",
        "unit"
      ],
      "properties": {
        "state": {
          "const": "known"
        },
        "amount": {
          "$ref": "#/$defs/nonNegativeDecimal"
        },
        "unit": {
          "$ref": "#/$defs/massOrInternationalUnit"
        }
      }
    },
    "massOrIUNutrientBelowReportingThreshold": {
      "description": "Present but under the provider's reporting threshold. The unit is optional, because a provider may report the state without one.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "const": "below_reporting_threshold"
        },
        "unit": {
          "$ref": "#/$defs/massOrInternationalUnit"
        }
      }
    },
    "nutrientUnknown": {
      "description": "The provider does not state this nutrient for this product.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "const": "unknown"
        }
      }
    },
    "nutrientNotApplicable": {
      "description": "This nutrient does not apply to this product at all.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "const": "not_applicable"
        }
      }
    },
    "source": {
      "description": "Where the record came from and under what licence it may be reused. Every record states its licence.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "licence",
        "attribution"
      ],
      "properties": {
        "name": {
          "description": "Provider key, for example usda_fdc, dsld or open_food_facts.",
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]{0,63}(?!\\n)$"
        },
        "licence": {
          "description": "SPDX-style licence identifier of the source data.",
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]{0,63}(?!\\n)$"
        },
        "attribution": {
          "description": "The credit line the licence requires. Safe to show to a user; never a person or an account.",
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u061c\\u180e\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u206f\\ud800-\\udfff\\ufeff\\ufff9-\\ufffb\\ufffe\\uffff\udb40\udc00-\udb40\udc7f\\u0020\\u00a0\\u1680\\u2000-\\u200a\\u202f\\u205f\\u3000](?:[^\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u061c\\u180e\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u206f\\ud800-\\udfff\\ufeff\\ufff9-\\ufffb\\ufffe\\uffff\udb40\udc00-\udb40\udc7f]*[^\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u061c\\u180e\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u206f\\ud800-\\udfff\\ufeff\\ufff9-\\ufffb\\ufffe\\uffff\udb40\udc00-\udb40\udc7f\\u0020\\u00a0\\u1680\\u2000-\\u200a\\u202f\\u205f\\u3000])?(?!\\n)$"
        },
        "url": {
          "description": "Public https page describing the source record.",
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https://[!-~]+(?!\\n)$"
        }
      }
    }
  }
}
